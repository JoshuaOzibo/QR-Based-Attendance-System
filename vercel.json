{
  "version": 2,
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/dist/client",
  "rewrites": [
    {
      "source": "/assets/(.*)",
      "destination": "/frontend/dist/client/assets/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/frontend/api/index"
    }
  ]
}
